@{
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
    var userName = Context.Session.GetString("user_name");
    var role_code = Context.Session.GetString("user_role");
    var userCode = Context.Session.GetString("user_code");
    var menuJson = Context.Session.GetString("UserMenus");
    var menus = new List<MenuModel>();

    if (!string.IsNullOrEmpty(menuJson))
    {
        menus = System.Text.Json.JsonSerializer.Deserialize<List<MenuModel>>(menuJson);
    }
    var currentPath = Context.Request.Path.Value.ToLower();
    var normalizedPath = currentPath.Trim('/').ToLower();
    var getBoaMenu = menus?.FirstOrDefault(x =>
        (x.menu_url ?? "")
            .Replace("../", "")
            .Trim('/')
            .ToLower() == "boa/boa"
    );
    var Boachecklist = getBoaMenu?.Boachecklist_perm;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Run Entitlement</title>
    <style>
        .content-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link {
            background-color: #027ed1 !important;
            color: #fff !important;
        }

        .nav-tabs .nav-item .nav-link:not(.active) {
            background-color: #716969;
            color: #fff;
        }

        /* Alternate row color */
        #rejectionList .k-grid-content tr.k-alt td {
            background-color: #fff;
            color: #000;
        }

        /* Consistent borders */
        #rejectionList .k-grid-header th,
        #rejectionList .k-grid-content td {
            border-right: 1px solid #ddd;
        }

            /* Remove last border */
            #rejectionList .k-grid-header th:last-child,
            #rejectionList .k-grid-content td:last-child {
                border-right: none;
            }

        /* Fixed layout for alignment */
        #rejectionList .k-grid-header table,
        #rejectionList .k-grid-content table {
            table-layout: fixed;
            width: 100%;
        }

        /* Prevent wrapping */
        #rejectionList .k-grid-header th,
        #rejectionList .k-grid-content td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Compact size */
        #rejectionList .k-grid-content td {
            padding: 3px 6px;
            font-size: 12px;
            line-height: 18px;
            background: #fff;
        }

        #rejectionList .k-grid-header th {
            padding: 4px 6px;
            font-size: 12px;
            line-height: 18px;
        }

        /* Compact row height */
        #rejectionList .k-grid-content tr {
            height: 26px;
        }

        #rejectionList .k-grid-header tr {
            height: 28px;
        }

        .k-grid td {
            padding: 2px 2px;
            font-size: 13px;
        }

        .ui-autocomplete {
            max-height: 250px;
            overflow-y: auto;
            overflow-x: hidden;
            font-size: 13px;
        }

        #spinner {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255,255,255,0.3);
            z-index: 99999 !important;
        }

            #spinner img,
            #spinner .spinner-border {
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
            }

        /*  // search */

        .search-box {
            position: relative;
            width: 100%;
        }

            .search-box input {
                width: 100%;
                padding-right: 35px;
            }

            .search-box i {
                position: absolute;
                right: 8px;
                top: 50%;
                transform: translateY(-50%);
                cursor: pointer;
                color: #0d6efd;
                z-index: 10;
            }

        #rejectionList {
            width: 30% !important;
            overflow: hidden;
            height: 132px !important;
        }
        k-grid-content-locked {
            width: 305px !important;
            height: 147px !important;
        }

        .k-grid-content {
            width: 100% !important;
            height: 202px !important;
        }

        .k-grid-footer {
            margin-top: -125px !important;
        }

        #rejectionList .k-grid-header-wrap {
            width: 146px !important;
        }

        .k-grid.k-widget {
            height: 276px !important;
        }
    </style>
</head>

<body class="hold-transition skin-blue sidebar-mini fixed">
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="card-body" style="margin-top:5px;height: 556px;width: 103%;margin-left: -18px;">
                <div class="row" style="margin-top:-17px;">
                    <div class="col-sm-3">
                        <label class="form-label" for="ctype" data-field="ctype">IPO Name</label>&nbsp;<span style="font-size: 12px;color:red;font-weight: bold;">*</span>
                        <input type="text" class="form-control" id="iponame" readonly />
                    </div>
                    <div class="col-sm-9">
                        <span>
                            <button type="button" class="btn btn-primary" id="btnSave" onclick="runrecon(true)" style="padding: 3px 25px;margin-top:28px;">Run Entitlement</button>
                            &nbsp;&nbsp;
                            <button type="button" onclick="exportSummary()" class="btn btn-primary" id="btnGen" style="padding: 3px 25px;margin-top:28px;">Export Summary </button>
                            &nbsp;&nbsp;
                            <button type="button" onclick="exportdetailSummary()" class="btn btn-primary" id="btnGensummary" style="padding: 3px 25px;margin-top:28px; white-space: nowrap;">Export Detail Summary </button>
                            &nbsp;&nbsp;
                            @* @if (ViewBag.canAdd)
                            {
                                <button type="button" onclick="additions()" class="btn btn-primary" id="btnAdditions" style="padding: 3px 25px;margin-top:28px; white-space: nowrap;">Plus </button>
                                <span>&nbsp;&nbsp;</span>
                            }

                            @if (ViewBag.canDelete)
                            {
                                <button type="button" onclick="rejections()" class="btn btn-primary" id="btnRejections" style="padding: 3px 25px;margin-top:28px; white-space: nowrap;">Minus </button>
                            } *@
                        </span>
                    </div>
                </div>
                <div class="row" style="margin-top:20px;">
                    <div class="col-sm-12">
                        <div id="rejectionList"></div>
                    </div>
                </div>
                <div class="row" id="entitlementGridSection" style="margin-top:20px; ">
                    <div class="col-sm-12">
                        <div id="entitlementGrid"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
<script>
    var selectedCodes = [];
    $(document).ready(function () {
        $('#navhead').text('Run Entitlement'); 
        var ipoName = localStorage.getItem("selectedIPOText");
        $("#iponame").val(ipoName);
        $("#rejectionList").show();
        // $("#entitlementGridSection").hide();
        var offer_code =  localStorage.getItem("selectedIPO");
        if(offer_code){
            // runrecon(false);
            getRightsEntitlement(offer_code);
        }
        var boaChecklist = '@Boachecklist';
        var getnormalizedPath = '@normalizedPath';
        if(boaChecklist == "Y") {
            updateboaVisit(getnormalizedPath);
        }
    });

    function runrecon(runRule) {

        var offer_code = localStorage.getItem("selectedIPO");

        var data = "";

        // Load first grid
        fetchrejgrid(data, runRule);

        // ONLY when Run Entitlement button is clicked
        if (runRule === true) {

            $.ajax({
                type: "POST",
                url: '@Url.Action("InsRightsEntitlement", "RunEntitlement")',
                data: {
                    offer_code: offer_code
                },
                success: function (response) {

                    if (response && response.success) {

                        // Insert SP successful
                        if (response.result === "success") {

                            // Now call second SP
                            getRightsEntitlement(offer_code);

                        } else {

                            $.alert({
                                title: 'IPO Allotment',
                                content: 'Rights entitlement insertion failed.',
                                type: 'red'
                            });
                        }

                    } else {

                        $.alert({
                            title: 'IPO Allotment',
                            content: response.message || 'Rights entitlement insertion failed.',
                            type: 'red'
                        });
                    }
                },
                error: function (er) {
                    console.log(er);
                }
            });

            // Show second grid if you still need it
            $("#entitlementGridSection").show();
        }
        else {
            $("#entitlementGridSection").hide();
        }
    }

    function getRightsEntitlement(offer_code) {

        $.ajax({
            type: "GET",
            url: '@Url.Action("GetRightsEntitlement", "RunEntitlement")',
            data: {
                offer_code: offer_code
            },

            success: function (response) {

                console.log("GET Response:", response);

                if (response && response.success) {

                    var result = response.data;

                    console.log("Summary:", result.summary);
                    console.log("Details:", result.details);
                    console.log("disable_flag:", result.disable_flag);


                    var disableFlag = result.disable_flag;

                    if (disableFlag && disableFlag.length > 0) {
                        disableFlag = String(disableFlag[0]).trim().toUpperCase();
                    }

                    if (disableFlag === "Y") {
                        $("#btnSave").prop("disabled", true);
                    } else {
                        $("#btnSave").prop("disabled", false);
                    }
                    // =====================================
                    // FIRST GRID
                    // =====================================

                    var summaryData = result.summary;

                    var gridData = [
                        {
                            rule_code: "1",
                            rule_name: "CDSL",
                            original_qty_count: 0
                        },
                        {
                            rule_code: "2",
                            rule_name: "NSDL",
                            original_qty_count: 0
                        },
                        {
                            rule_code: "3",
                            rule_name: "Physical",
                            original_qty_count: 0
                        }
                    ];

                    summaryData.forEach(function (item) {

                        var depository = item[0];
                        var noOfShares = item[1];

                        if (depository === "CDSL") {

                            gridData[0].original_qty_count =
                                Number(noOfShares) || 0;
                        }

                        else if (depository === "NSDL") {

                            gridData[1].original_qty_count =
                                Number(noOfShares) || 0;
                        }
                    });

                    console.log("First Grid Data:", gridData);

                    fetchrejgrid(gridData, true);


                    // =====================================
                    // SECOND GRID
                    // SHOW ALL RECORDS
                    // =====================================

                    var detailsData = result.details;

                    console.log(
                        "Total Second Grid Records:",
                        detailsData.length
                    );

                    var formattedDetails = detailsData.map(function (item) {

                        return {
                            dp_client_id: item[0],
                            pan: item[1],
                            Investor_Name: item[2],
                            Depository: item[3],
                            dp_id: item[4],
                            client_id: item[5],
                            holding_qty: item[6],
                            ratio: item[7],
                            Entitlement: item[8],
                            Additional_Applied: item[9],
                            Total_Applied: item[10],
                            Allotted: item[11],
                            Unallotted: item[12],
                            Status: item[13]
                        };

                    });

                    console.log(
                        "Formatted Second Grid Data:",
                        formattedDetails
                    );

                    // Store all records
                    window.rightsEntitlementDetails =
                        formattedDetails;

                    // Bind ALL records
                    loadEntitlementGrid(formattedDetails);
                }
                else {

                    $.alert({
                        title: 'IPO Allotment',
                        content:
                            response.message ||
                            'Failed to get entitlement data.',
                        type: 'red'
                    });
                }
            },

            error: function (er) {

                console.log("GET API Error:", er);
            }
        });
    }

    function fetchrejgrid(data, runRule){
        console.log("Grid data:", data);
        $("#rejectionList").show();
        var columns =  [
                {
                field: "rule_code",
                title: "Rule Code",
                locked: true,
                hidden: true,
            },
            {
                field: "rule_name",
                title: "Depository",
                width: 260,
                locked: true,
                template: function(dataItem) {

                    if (dataItem.rule_code === "1") {
                        return "CDSL";
                    }
                    else if (dataItem.rule_code === "2") {
                        return "NSDL";
                    }
                    else if (dataItem.rule_code === "3") {
                        return "Physical";
                    }

                    return dataItem.rule_name;
                },
                footerTemplate: "TOTAL",
                footerAttributes: {
                    style: "text-align:center;font-weight:bold;"
                }
            },
            {field: "original_qty_count", title: "No.of Shares", width: 130, attributes:{style:"text-align:right;"}, footerTemplate: "#= kendo.toString(sum, 'n0') #",  footerAttributes: { style: "text-align:right;font-weight:bold;" } }
        ];
        if ($("#rejectionList").data("kendoGrid")) {
            $("#rejectionList").data("kendoGrid").destroy();
            $("#rejectionList").empty();
        }
        $("#rejectionList").kendoGrid({
            dataSource: {
                data: data,
                pageSize: 20,
                aggregate: [
                    { field: "original_appl_count", aggregate: "sum" },
                    { field: "original_qty_count", aggregate: "sum" },
                    { field: "original_total_amount", aggregate: "sum" },

                    { field: "additions_appl_count", aggregate: "sum" },
                    { field: "additions_qty_count", aggregate: "sum" },
                    { field: "additions_total_amount", aggregate: "sum" },

                    { field: "rejections_appl_count", aggregate: "sum" },
                    { field: "rejections_qty_count", aggregate: "sum" },
                    { field: "rejections_total_amount", aggregate: "sum" },

                    { field: "total_app_count", aggregate: "sum" },
                    { field: "total_qty_amount", aggregate: "sum" },
                    { field: "total_amount", aggregate: "sum" }
                ]
            },
            height: 410,
            sortable: true,
            filterable: true,
            resizable: true,
            columns: columns,
            excel: {
            fileName: "Rejection_Summary_Report.xlsx",
            allPages: true,
            filterable: true
        },
            excelExport: function (e) {
                var sheet = e.workbook.sheets[0];
                sheet.rows.forEach(function (row) {
                    if (row.type === "footer") {
                        row.cells.forEach(function (cell) {
                            if (typeof cell.value === "string") {
                                cell.value = cell.value.replace(/<[^>]+>/g, "");
                            }
                            cell.bold = true;
                            cell.hAlign = "right";
                        });
                    }
                });
            },
            dataBound: function () {
            var grid = this;
                grid.tbody.find("tr").each(function () {
                    var dataItem = grid.dataItem(this);
                    if (selectedCodes.includes(dataItem.rule_code)) {
                        $(this).find(".client-checkbox").prop("checked", true);
                    }
                });
            }
        });
    }

    $(document).on("click", "#selectAll", function () {
        var isChecked = this.checked;

        $(".client-checkbox").each(function () {
            $(this).prop("checked", isChecked);
        });
    });

    $(document).on("change", "#selectAll", function () {
        var grid = $("#rejectionList").data("kendoGrid");
        selectedCodes = [];
        if (this.checked) {
            var allData = grid.dataSource.data();
            selectedCodes = allData.map(function (item) {
                return item.rule_code;
            });
        } else {
            selectedCodes = [];
        }
        grid.tbody.find(".client-checkbox").prop("checked", this.checked);
    });

    $(document).on("change", ".client-checkbox", function () {
        var grid = $("#rejectionList").data("kendoGrid");
        var row = $(this).closest("tr");
        var dataItem = grid.dataItem(row);
        var code = dataItem.rule_code;
        if ($(this).is(":checked")) {
            if (!selectedCodes.includes(code)) {
                selectedCodes.push(code);
            }
        } else {
            selectedCodes = selectedCodes.filter(x => x !== code);
        }
    });

    function exportSummary() {
        var grid = $("#rejectionList").data("kendoGrid");
        grid.saveAsExcel();
        selectedCodes = [];
    }

    function exportdetailSummary() {
        var grid = $("#entitlementGrid").data("kendoGrid");
        grid.saveAsExcel();
        selectedCodes = [];
    }

    function loadEntitlementGrid(data) {

        console.log("Loading Second Grid:", data.length);

        $("#entitlementGrid").kendoGrid({
            dataSource: {
                data: data,
                pageSize: 10
            },

            pageable: true,
            sortable: true,
            filterable: true,
            resizable: true,
            excel: { fileName: "Rights_Entitlement_Detail_Summary.xlsx", allPages: true, filterable: true },
            columns: [
                {
                    field: "dp_client_id",
                    title: "Folio No. / BO ID",
                    width: 170
                },
                {
                    field: "pan",
                    title: "PAN",
                    width: 120
                },
                {
                    field: "Investor_Name",
                    title: "Investor Name",
                    width: 160
                },
                {
                    field: "Depository",
                    title: "Depository",
                    width: 130
                },
                {
                    field: "dp_id",
                    title: "DP ID",
                    width: 120
                },
                {
                    field: "client_id",
                    title: "Client ID",
                    width: 120
                },
                {
                    field: "holding_qty",
                    title: "Shares Held",
                    width: 140
                },
                {
                    field: "ratio",
                    title: "Rights Ratio",
                    width: 140
                },
                {
                    field: "Entitlement",
                    title: "Entitlement",
                    width: 130
                },
                {
                    field: "Additional_Applied",
                    title: "Additional Applied",
                    width: 180
                },
                {
                    field: "Total_Applied",
                    title: "Total Applied",
                    width: 150
                },
                {
                    field: "Allotted",
                    title: "Allotted",
                    width: 100
                },
                {
                    field: "Unallotted",
                    title: "Unallotted",
                    width: 110
                },
                {
                    field: "Status",
                    title: "Status",
                    width: 150
                }
            ]
        });
    }
</script>