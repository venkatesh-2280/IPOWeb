        function populateDetails(item) {
            $("#appno").val(item.appl_no);
            $("#orderno").val(item.order_no);
            $("#panno").val(item.pan_no);
            $("#shares").val(item.quantity);
            $("#amt").val(item.total_amount);
            $("#shared_applied_price").val(item.shared_applied_price);
            $("#rule_code").val(item.rule_code);
            $("#reject_remarks").val(item.rejected_reason);
            $("#remarks").val("");
            $("#addrule_disable").val(item.addrule_disable);
            $("#addlblstatus").val("");
            if (item.addrule_disable == "Y")
            {
            $("#addlblstatus").show().text("Exchanges Rejection applications are not changed");
            $("#btnAddSave").hide();
            } else {
                $("#addlblstatus").hide().text("");
                $("#btnAddSave").show();
            }

        }

        function populateRDetails(item) {
              $("#rappno").val(item.appl_no);
              $("#rorderno").val(item.order_no);
              $("#rpanno").val(item.pan_no);
              $("#rshares").val(item.quantity);
              $("#ramt").val(item.total_amount);
              $("#rshared_applied_price").val(item.shared_applied_price);
              $("#rremarks").val(item.rejected_reason);
          }

        function get_rule_code() {
            var ipo_code =  localStorage.getItem("selectedIPO");
            $.ajax({
                type: "POST",
                url: '@Url.Action("Getrulecode", "Rejection")',
                data: {
                    ipo_code: ipo_code
                },
                dataType: "json",
                success: function (response) {
                    if (!response.success) {
                        return;
                    }
                    var data = JSON.parse(response.data);
                    $("#rrule_code").empty();
                    $("#rrule_code").append(
                        $('<option>', {
                            value: '',
                            text: '-- Select --'
                        })
                    );

                   $.each(data.Table, function (i, item) {
                    $("#rrule_code").append(
                        $('<option>', {
                            value: item.rule_code,
                            text:  item.rule_name
                        })
                    );
                });

                },
                error: function (xhr) {
                    console.log("Error:", xhr.responseText);
                }
            });
        }
</script>