            $("#ramt").val('');
            $("#additionremarks").val('');
            var modal = new bootstrap.Modal(
                document.getElementById('rejectionsModal')
            );
            modal.show();
              var offer_code =  localStorage.getItem("selectedIPO");
            //  loadaddrejlist(offer_code)
        }

           function SearchRejectionData(type,flag)
    {
        var ipoCode =  localStorage.getItem("selectedIPO");
        var appNo = "";
        var orderNo = "";
        var panNo = "";
        if(flag=="R")
        {

            if (type == "APP")
                appNo = $("#appno").val().trim();

            if (type == "ORDER")
                orderNo = $("#orderno").val().trim();

            if (type == "PAN")
                panNo = $("#panno").val().trim();
        }
        else if(flag=="A")
        {

             if (type == "APP")
                appNo = $("#rappno").val().trim();

