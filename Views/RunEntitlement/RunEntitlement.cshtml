<script>
        var selectedCodes = [];
             $(document).ready(function () {
                $('#navhead').text('Run Rejection'); 
                var ipoName = localStorage.getItem("selectedIPOText");
                $("#iponame").val(ipoName);
                $("#rejectionList").hide();
                var offer_code =  localStorage.getItem("selectedIPO");
                if(offer_code){
                    runrecon(false);
                 }
                var boaChecklist = '@Boachecklist';
                var getnormalizedPath = '@normalizedPath';
                if(boaChecklist == "Y") {
                   updateboaVisit(getnormalizedPath);
                }
            });

           function runrecon(runRule) {
             var offer_code =  localStorage.getItem("selectedIPO");
              try {
                customAjax({
                    type: "GET",
                    url: '@Url.Action("getRejReason", "Rejection")',
                    data: {
                    offer_code: offer_code,
                    runRule : runRule
                    },
                    success: function (response) {
                        if (response && response.success) {
                          var data = JSON.parse(response.data);
                          fetchrejgrid(data);
                        }
                        else {
                            $.alert({
                                title: 'IPO Allotment',
                                content: 'Save failed!',
                                type: 'red',
                            });
                        }
                    },
                    error: function (er) {
                        console.log(er);
                    }
                });
            } catch (e) {
                console.log(e);
            }
        }


         function fetchrejgrid(data){
             var demoData = [
                {
                    rule_code: "1",
                    rule_name: "CDSL",
                    original_appl_count: 100,
                    original_qty_count: 5000,
                    original_total_amount: 250000
                },
                {
                    rule_code: "2",
                    rule_name: "NSDL",
                    original_appl_count: 150,
                    original_qty_count: 7500,
                    original_total_amount: 375000
                },
                {
                    rule_code: "3",
                    rule_name: "Physical",
                    original_appl_count: 50,
                    original_qty_count: 2500,
                    original_total_amount: 125000
                }
            ];

            data = demoData;
             $("#rejectionList").show();
            var columns =  [
                {
                    title: "Select",
                    width: 45,
                    locked: true,
                    headerAttributes: { style: "text-align:center;" },
                    attributes: { style: "text-align:center;" },
                    headerTemplate:
                        "<div style='text-align:center;'>" +
                        "<input type='checkbox' id='selectAll' /> " +
                        "<label for='selectAll' style='cursor:pointer;'>All</label>" +
                        "</div>",
                    template: "<input type='checkbox' class='client-checkbox' value='#= rule_name #' />"
                },
                 {
                 field: "rule_code",
                 title: "Rule Code",
                 locked: true,
                 hidden: true,
             },
                {
                    field: "rule_name",
                    title: "Reject Reason",
                    width: 260,
                    locked: true,
                    template: function(dataItem) {

                        if (dataItem.rule_code === "1") {
                            return "CDSL";
                        }
                        else if (dataItem.rule_code === "2") {
                            return "NSDL";
                        }
                        else if (dataItem.rule_code === "3") {
                            return "Physical";
                        }

                        return dataItem.rule_name;
                    },
                    footerTemplate: "TOTAL",
                    footerAttributes: {
                        style: "text-align:center;font-weight:bold;"
                    }
                },
                {
                    title: "Rejections",
                    headerAttributes: { style: "text-align:center;font-weight:bold;" },
                    columns: [
                            { field: "original_appl_count", title: "No.of Appl", width: 120, attributes:{style:"text-align:right;"}, footerTemplate: "#= kendo.toString(sum, 'n0') #", footerAttributes: { style: "text-align:right;font-weight:bold;" } },
                            { field: "original_qty_count", title: "No.of Shares", width: 130, attributes:{style:"text-align:right;"}, footerTemplate: "#= kendo.toString(sum, 'n0') #",  footerAttributes: { style: "text-align:right;font-weight:bold;" } },
                            { field: "original_total_amount", title: "Amount", width: 120, attributes:{style:"text-align:right;"}, footerTemplate: "#= kendo.toString(sum, 'n0') #",  footerAttributes: { style: "text-align:right;font-weight:bold;" }  },

                    ]
                }
            ];
                     if ($("#rejectionList").data("kendoGrid")) {
                        $("#rejectionList").data("kendoGrid").destroy();
                        $("#rejectionList").empty();
                     }
                         $("#rejectionList").kendoGrid({
                         dataSource: {
                             data: data,
                             pageSize: 20,
                             aggregate: [
                                { field: "original_appl_count", aggregate: "sum" },
                                { field: "original_qty_count", aggregate: "sum" },
                                { field: "original_total_amount", aggregate: "sum" },

                                { field: "additions_appl_count", aggregate: "sum" },
                                { field: "additions_qty_count", aggregate: "sum" },
                                { field: "additions_total_amount", aggregate: "sum" },

                                { field: "rejections_appl_count", aggregate: "sum" },
                                { field: "rejections_qty_count", aggregate: "sum" },
                                { field: "rejections_total_amount", aggregate: "sum" },

                                { field: "total_app_count", aggregate: "sum" },
                                { field: "total_qty_amount", aggregate: "sum" },
                                { field: "total_amount", aggregate: "sum" }
                            ]
                         },
                         height: 410,
                         pageable: {
                             pageSizes: [10, 20, 30],
                             refresh: true
                         },
                         sortable: true,
                         filterable: true,
                         resizable: true,
                         columns: columns,
                          excel: {
                            fileName: "Rejection_Summary_Report.xlsx",
                            allPages: true,
                            filterable: true
    },
                excelExport: function (e) {
                    var sheet = e.workbook.sheets[0];
                    sheet.rows.forEach(function (row) {
                        if (row.type === "footer") {
                            row.cells.forEach(function (cell) {
                                if (typeof cell.value === "string") {
                                    cell.value = cell.value.replace(/<[^>]+>/g, "");
                                }
                                cell.bold = true;
                                cell.hAlign = "right";
                            });
                        }
                    });
                           },
                         dataBound: function () {
                            var grid = this;
                            grid.tbody.find("tr").each(function () {
                                var dataItem = grid.dataItem(this);
                                if (selectedCodes.includes(dataItem.rule_code)) {
                                    $(this).find(".client-checkbox").prop("checked", true);
                                }
                            });
                         }
                     });
        }

         $(document).on("click", "#selectAll", function () {
            var isChecked = this.checked;

            $(".client-checkbox").each(function () {
                $(this).prop("checked", isChecked);
            });
        });

         $(document).on("change", "#selectAll", function () {
            var grid = $("#rejectionList").data("kendoGrid");
            selectedCodes = [];
            if (this.checked) {
                var allData = grid.dataSource.data();
                selectedCodes = allData.map(function (item) {
                 return item.rule_code;
                });
            } else {
                selectedCodes = [];
            }
            grid.tbody.find(".client-checkbox").prop("checked", this.checked);
        });

        $(document).on("change", ".client-checkbox", function () {
            var grid = $("#rejectionList").data("kendoGrid");
            var row = $(this).closest("tr");
            var dataItem = grid.dataItem(row);
            var code = dataItem.rule_code;
            if ($(this).is(":checked")) {
                if (!selectedCodes.includes(code)) {
                    selectedCodes.push(code);
                }
            } else {
                selectedCodes = selectedCodes.filter(x => x !== code);
            }
        });

        function exportSummary() {
            var grid = $("#rejectionList").data("kendoGrid");
            grid.saveAsExcel();
            selectedCodes = [];
        }

        function exportdetailSummary() {

            if (selectedCodes.length === 0) {
                $.alert({
                    title: 'IPO Web',
                    content: "Please select at least one Reason",
                    type: 'red',
                });
                return;
            }
            var rule_code = selectedCodes.join(",");
            var offer_code = localStorage.getItem("selectedIPO");
            var url = '/Rejection/getdetailRejectionSummary'
                + '?offer_code=' + encodeURIComponent(offer_code)
                + '&rule_code=' + encodeURIComponent(rule_code);

            window.location.href = url;
            selectedCodes = [];
        }

        $(document).ready(function () {
            get_rule_code();
        });
