                                $("#additionremarks").val('');
                                $("#appno").val('');
                                $("#orderno").val('');
                                $("#panno").val('');
                                $("#qty").val('');
                                $("#shares").val('');
                                $("#amt").val('');
                                $("#remarks").val('');
                                $("#shared_applied_price").val('');
                                $("#reject_remarks").val('');
                                $("#addlblstatus").text("");
                                $("#rule_code").val('');
                                if(flag=="A")
                                {
                                    $.alert({
                                    title: 'IPO Allotment',
                                    content:"Given Appl.no has already not valid",
