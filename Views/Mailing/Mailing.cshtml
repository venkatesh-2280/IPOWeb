       function generateRightsIssueTemplate() {

        var template = $("#rightsIssueTemplate").html();

        // Show HTML source in textarea
        $("#mailBody").val(template);

        // Render HTML preview
        $("#mailPreview").html(template);
    }

    function sendBulkMail() {
        var ipocode = $("#ipocode").val();
        var subject = $("#mailSubject").val().trim();
        var body = $("#mailBody").val().trim();
        var $status = $("#sendStatus");
        var in_action = "Entitlement";

        if (!ipocode) { $status.css("color", "red").text("Select an IPO first."); return; }
        if (!subject || !body) { $status.css("color", "red").text("Subject and message are required."); return; }

        $("#btnSend").prop("disabled", true);
        $status.css("color", "#666").text("Sending...");

        customAjax({
            type: "POST",
            url: '@Url.Action("SendBulkMail", "Mailing")',
            data: JSON.stringify({
                OfferCode: ipocode,
                MailType: $("#mailType").val(),
                Subject: subject,
                HtmlContent: body,
                in_action:in_action
            }),
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                 console.log("Send Response:", response);
                $("#btnSend").prop("disabled", false);
                if (!response) { $status.css("color", "red").text("Failed to send."); return; }
                if (response.success) {
                    $status.css("color", "green").text(
                        "Sent " + response.sentCount + " of " + response.totalRecipients +
                        (response.failedCount ? (" (" + response.failedCount + " failed)") : "") + " Successfully."
                    );
                } else {
                    $status.css("color", "red").text((response.message) || ((response.errors || []).join("; ")) || "Failed to send.");
                }
            },
            error: function () {
                $("#btnSend").prop("disabled", false);
                $status.css("color", "red").text("Failed to send.");
            }
        });
    }
</script>

<script type="text/template" id="rightsIssueTemplate">
    <!DOCTYPE html>
    <html>
    <head>
