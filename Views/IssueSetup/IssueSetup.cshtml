@{
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
    var userName = Context.Session.GetString("user_name");
    var userCode = Context.Session.GetString("user_code");
    var role_code = Context.Session.GetString("user_role");
    var menuJson = Context.Session.GetString("UserMenus");
    var menus = string.IsNullOrEmpty(menuJson)
        ? new List<MenuModel>()
        : System.Text.Json.JsonSerializer.Deserialize<List<MenuModel>>(menuJson);

    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
    var normalizedPath = currentPath.Trim('/');

    var currentMenu = menus.FirstOrDefault(x =>
        (x.menu_url ?? "")
            .Replace("../", "")
            .Trim('/')
            .ToLower() == normalizedPath
    );

    var addPerm = currentMenu?.add_perm ?? "N";
    var modPerm = currentMenu?.mod_perm ?? "N";
    var viewPerm = currentMenu?.view_perm ?? "N";
    var delPerm = currentMenu?.delete_perm ?? "N";
    var appRejPerm = currentMenu?.Approve_perm ?? "N";
    var getBoaMenu = menus?.FirstOrDefault(x =>
        (x.menu_url ?? "")
            .Replace("../", "")
            .Trim('/')
            .ToLower() == "boa/boa"
    );
    var Boachecklist = getBoaMenu?.Boachecklist_perm;
}
