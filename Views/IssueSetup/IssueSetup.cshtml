                                      else {
                                          $.alert({
                                              title: 'IPO Allotment',
                                              content: 'Save failed!',
                                              type: 'red',
                                          });
                                      }
                                  }
                              });
                          } catch (e) {
                              console.log(e);
                      }
                             }
           }
           else {
                    $.alert({
                      title: 'Validation',
                      content: 'Client Code must not be empty!',
                      type: 'red'
                  });
          }


