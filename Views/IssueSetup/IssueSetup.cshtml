        function setPostPrice() {

        var preCapital = parseFloat($("#preissue").val()) || 0;

        // IMPORTANT: use offer_type, not offertype
        var offerType = $("#offer_type").val();

        // =========================
        // RIGHTS OFFER
        // =========================
        if (offerType === "Rights Offer") {

            var ratio = $("#ratio").val().trim();

            var numerator = 0;
            var denominator = 0;

            if (ratio.includes(":")) {

                var ratioParts = ratio.split(":");

                numerator = parseFloat(ratioParts[0].trim()) || 0;
                denominator = parseFloat(ratioParts[1].trim()) || 0;
            }

            if (preCapital > 0 && numerator > 0 && denominator > 0) {

                // Offer Size = Pre Offer Capital × Ratio
                var offerSize = preCapital * (numerator / denominator);

                // Post Offer Capital = Pre Offer Capital + Offer Size
                var postCapital = preCapital + offerSize;

                $("#issuesize").val(offerSize.toFixed(2));
                $("#postissue").val(postCapital.toFixed(2));

            } else {

                $("#issuesize").val("");
                $("#postissue").val("");
            }
        }

        // =========================
        // OTHER OFFER TYPES / SME
        // =========================
        else {

            // User manually enters Offer Size
            var offerSize = parseFloat($("#issuesize").val()) || 0;

            // Post Offer Capital = Pre Offer Capital + Offer Size
            var postCapital = preCapital + offerSize;

            $("#postissue").val(postCapital.toFixed(2));
        }
    }


    // Recalculate when values are entered/changed
    $("#preissue, #ratio, #issuesize").on("input", function () {
        setPostPrice();
    });

          function validatePrices() {
              var min = parseFloat($("#minprice").val()) || 0;
              var max = parseFloat($("#maxprice").val()) || 0;
              var cutoff = parseFloat($("#cutoffprice").val()) || 0;
              var isValid = true;
              if (max <= min) {
                  $.alert({
                      title: 'IPO Web',
                      content: "Maximum Price should be greater than Minimum Price",
                      type: 'green',
                  });
                  isValid = false;
              }
              if (cutoff < min || cutoff > max) {
                  $.alert({
                      title: 'IPO Web',
                      content: "Cut Off Price should be between Minimum and Maximum Price",
                      type: 'red',
                  });
                  isValid = false;
              }
              return isValid;
          }

