        $("#offer_type").on("change", function () {
        var offerType = $(this).val();
        if (offerType === "Rights Offer") {
            $("#empdiscount").val("");
            $("#empdiscount").prop("readonly", true);
            $("#cutoffprices").hide();
            $("#maxprices").hide();
            $("#minprices").hide();
            $("#fixedprice").hide();
            $("#pricetypes").hide();
            $("#lotsizes").hide();
            $("#recordprice").show();
            $("#ratios").show();
            // Rights Offer -> Offer Size is auto calculated
            $("#issuesize").prop("readonly", true);
            $("#preissue").val("");
        } else {
            $("#empdiscount").prop("readonly", false);
            $("#cutoffprices").show();
            $("#maxprices").show();
            $("#minprices").show();
            $("#fixedprice").show();
            $("#pricetypes").show();
            $("#lotsizes").show();
