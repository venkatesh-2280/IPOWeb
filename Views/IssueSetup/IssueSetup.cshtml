          function fetchofferCategory(data) {
              var role_code =  '@role_code';
              data.forEach(function (item) {
                  if (item.offer_cat_shares) {
                      item.offer_cat_shares = parseFloat(
                          item.offer_cat_shares.toString().replace(/,/g, "")
                      );
                  }
              });
              var columns = [
                  {
                      headerTemplate: `<input type="checkbox" id="selectAll" checked  />`,
                      width: 70,
                      template: `<input type="checkbox" class="rowCheckbox" checked />`,
                      editable: false,
                      hidden: true
                  },
                  {
                      field: "category_gid",
                      title: "ID",
                      hidden: true
                  },
                  {
                      field: "category_code",
                      title: "Cat Code"
                  },
                  {
                      field: "category_name",
                      title: "Category Name"
                  },
                  {
                      field: "offer_cat_shares",
                      title: "Share",
                      editor: numericEditor,
                      attributes: {
                          style: "text-align: right;"
                      },
                      template: function (dataItem) {
                          return formatIndianNumber(dataItem.offer_cat_shares);
                      },
                      footerTemplate: function (data) {
                          var sum = data.offer_cat_shares ? data.offer_cat_shares.sum : 0;
                          return "Total: " + formatIndianNumber(sum);
                      }
                  }
              ];
              var grid = $("#offerCategoryGrid").data("kendoGrid");
              if (grid) {
                  grid.destroy();
                  $("#offerCategoryGrid").empty();
              }

              $("#offerCategoryGrid").kendoGrid({
                  dataSource: {
                      data: data,
                      pageSize: 40,
                      aggregate: [
                          { field: "offer_cat_shares", aggregate: "sum" }
                      ],
                      schema: {
                          model: {
                              id: "category_gid",
                              fields: {
                                  category_gid: { editable: false },
                                  category_code: { editable: false },
                                  category_name: { editable: false },
                                  offer_cat_shares: { type: "number", editable: true }
                              }
                          }
                      },
                     change: function (e) {
                      if (e.field === "offer_cat_shares") {
                          var grid = $("#offerCategoryGrid").data("kendoGrid");
                          grid.refresh();
                      }
                  }
                  },
                  scrollable: {
                       height: 150
                  },
                  pageable: false,
                  sortable: true,
                  filterable: true,
                  resizable: true,
                  editable: role_code !== "IPOCHK" ? "incell" : false,
                 // editable: "incell",
                  beforeEdit: function (e) {
                  var fieldName = e.container.find("input").attr("name");
                  if (role_code === "IPOCHK" && (!fieldName || fieldName !== "offer_cat_shares")) {
                      e.preventDefault();
                  }
              },
                  columns: columns,
                  dataBound: function () {
                      $("#selectAll").off("click").on("click", function () {
                          $(".rowCheckbox").prop("checked", this.checked);
                      });
                      $(".rowCheckbox").off("click").on("click", function () {
                          if (!this.checked) {
                          } else {
                              var allChecked = $(".rowCheckbox").length === $(".rowCheckbox:checked").length;
                              $("#selectAll").prop("checked", allChecked);
                          }
                      });
                  }
              });
          }

         function validateCategoryTotal_old() {
              var issuesize = parseFloat($("#issuesize").val().replace(/,/g, '')) || 0;
              var grid = $("#offerCategoryGrid").data("kendoGrid");
              if (!grid) return false;
              var data = grid.dataSource.view();
              var total = 0;
              data.forEach(function (item) {
                  total += parseFloat(item.offer_cat_shares) || 0;
              });
              if (issuesize !== total) {
                  $.alert({
                      title: 'IPO Web',
                      content: "Category Total ₹ (" + total + ") must match with Issue Size Total ₹ (" + issuesize + ")",
                      type: 'red',
                  });
                  return false;
              }
              return true;
          }


              function validateCategoryTotal() {

          var issuesize = parseFloat($("#issuesize").val().replace(/,/g, '')) || 0;

          var grid = $("#offerCategoryGrid").data("kendoGrid");
          if (!grid) return false;

          var data = grid.dataSource.view();

          var total = 0;
          var isINDValid = false;

          data.forEach(function (item) {

              var shares = parseFloat(item.offer_cat_shares) || 0;

              total += shares;

              // IND category validation
              if (item.category_code === "IND" && shares > 0) {
                  isINDValid = true;
              }
          });

          // Validate issue size total
          if (issuesize !== total) {
              $.alert({
                  title: 'IPO Web',
                  content: "Category Total ₹ (" + total + ") must match with Issue Size Total ₹ (" + issuesize + ")",
                  type: 'red',
              });
              return false;
          }

          // Validate IND category mandatory
          if (!isINDValid) {
              $.alert({
                  title: 'IPO Web',
                  content: "IND category is mandatory and shares should be greater than 0.",
                  type: 'red',
              });
              return false;
          }

          return true;
      }

       function formatIndianNumber(x) {
                  if (x == null) return "";

                  var parts = x.toFixed(2).split(".");
                  var number = parts[0];
                  var decimal = parts[1];

                  var lastThree = number.substring(number.length - 3);
                  var otherNumbers = number.substring(0, number.length - 3);

                  if (otherNumbers !== "") {
                      lastThree = "," + lastThree;
                  }

                  var result = otherNumbers.replace(/\B(?=(\d{2})+(?!\d))/g, ",") + lastThree;

                  return result + "." + decimal;
              }

              function numericEditor(container, options) {
                  $('<input data-bind="value:' + options.field + '" />')
                      .appendTo(container)
                      .kendoNumericTextBox({
                          min: 0,
                          format: "n2"
                      });
                  container.find("input").css("text-align", "left");
              }

              function saveofferCategory() {
                  var status = $("#status").val();
                  var clientname = $("#clientname").val();
                  if (!validateCategoryTotal()) {
                  return;   // STOP SAVE
                    }
                  var grid = $("#offerCategoryGrid").data("kendoGrid");
                  var selectedData = [];
                  $("#offerCategoryGrid tbody tr").each(function () {
                      var checkbox = $(this).find(".rowCheckbox");
                      if (checkbox.is(":checked")) {
                          var dataItem = grid.dataItem(this);
                          selectedData.push({
                              category_gid: dataItem.category_gid,
                              offer_cat_code: dataItem.category_code,
                              offer_cat_name: dataItem.category_name,
                              offer_cat_shares: dataItem.offer_cat_shares
                          });
                      }
                  });
                  var isValid = true;
                  if (!isValid) return;
                       if(clientname) {
                                if((status === "Y" && activeOfferStatus ==="false") || (status === "" && activeOfferStatus === "false")) {
                              $.alert({
                                       title: 'Validation',
                                       content: 'Change the status to Draft and proceed...',
                                       type: 'red'
                                   });
                             } else {
                                        var payload = {};
                          payload.json_data = JSON.stringify(selectedData);
                          payload.offer_code = $("#offer_code").val();
                          payload.client_code = $("#clientcode").val();
                          payload.user_code = '@userName';
                          payload.action = "INSERT";
                          try {
                              customAjax({
                                  type: "POST",
                                  url: '@Url.Action("saveCategory", "IssueSetup")',
                                  data: JSON.stringify(payload),
                                  success: function (response) {
                                      if (response && response.success) {
                                          var data = JSON.parse(response.data);
                                          fetchIssuesetup();
                                          $.alert({
                                              title: 'IPO Allotment',
