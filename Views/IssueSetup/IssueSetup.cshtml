       function offerHeaderSave() {
           var isValid = true;
           var role_code =  '@role_code';
            if($("#clientname").val() === "") { $("#v_clientname").text("Please Choose Client Name"); isValid = false; } else {$("#v_clientname").text(""); }
              if($("#clientcode").val() === "") { $("#v_clientcode").text("Please Choose Client Code"); isValid = false; } else {$("#v_clientcode").text(""); }
              if($("#offer_type").val() === "") { $("#v_offer_type").text("Please Choose Offer Type");isValid = false;} else {$("#v_offer_type").text(""); }
              if($("#listing").val() === "") { $("#v_listing").text("Please Choose Listing");isValid = false; } else {$("#v_listing").text(""); }
              if($("#isin").val() === "") { $("#v_isin").text("Please Enter ISIN"); isValid = false; } else {$("#v_isin").text(""); }
              if($("#status").val() === "") { $("#v_status").text("Please Choose status");isValid = false; } else {$("#v_status").text(""); }
              if(($("#status").val() === "I" || $("#status").val() === "C") && $("#remarks").val() === "") { $("#v_remarks").text("Please Enter Remark"); isValid = false;} else {$("#v_remarks").text(""); }
              var clientname = $("#clientname").val();
              var status = $("#status").val();
              if(clientname) {
                   if ((status === "Y" && activeOfferStatus) || (status === "D") || (status === "I") || (status === "C") ) {
                if (isValid) {
                  var payload = {};
                  payload.offer_header_gid = $("#offer_header_gid").val();
                  payload.offer_code = $("#offer_header_gid").val() == 0 ? "" : $("#offer_code").val();
                  payload.offer_type = $("#offer_type").val();
                  payload.offer_listing_no = $("#listing").val();
                  payload.offer_isin = $("#isin").val();
                  payload.offer_status = $("#status").val();
                  payload.offer_empdiscount = $("#empdiscount").val();
                  payload.offer_remarks = $("#remarks").val();
                  payload.client_code = $("#clientcode").val();
                  payload.user_code = '@userCode';
                  payload.role_code = role_code;
                  payload.active_status = 'Y';
                  payload.ipo_status = $("#status").val() == 'D' ? "IP" : $("#ipostatus").val();
                  payload.action = $("#offer_header_gid").val() == 0 ? "INSERT": "UPDATE";
                  payload.delete_flag = 'N';
                  payload.boa_checked_status = 'N'
                  try {
                  $.ajax({
                      type: "POST",
                      url: '@Url.Action("OfferHeaderSave", "IssueSetup")',
                      dataType: 'json',
                      data: JSON.stringify(payload),
                      contentType: 'application/json; charset=utf-8',
                      success: function (response) {
                          var msg = "";
                          if (response && response.success) {
                              if($("#ipostatus").val() == 'MS' || $("#ipostatus").val() == 'CA' || $("#ipostatus").val() == 'CR' || $("#ipostatus").val() == 'MRS') {
                                 if($("#ipostatus").val() == 'MS') {
                                     msg = "Submitted Sucessfully .!"
                                 } else if($("#ipostatus").val() == 'CA') {
                                     msg = "Approved Sucessfully .!"
                                 } else if($("#ipostatus").val() == 'CR') {
                                     msg = "Rejected Sucessfully .!"
                                 } else if($("#ipostatus").val() == 'MRS') {
                                     msg = "Resubmitted Sucessfully .!"
                                 }
                                  $.alert({
                                  title: 'IPO Allotment',
                                  content:msg,
                                  type: 'green',
                                  buttons: {
                                      ok: {
                                          text: 'OK',
                                          action: function () {
                                             window.location.href = "../Dashboard/Dashboard?tab=offer";
                                          }
                                      }
                                  }
                                });
                              } else {
                                   var data = JSON.parse(response.data);
                                  $("#offer_header_gid").val(data[0].in_offer_header_gid);
                                  $("#offer_code").val(data[0].in_offer_code);
                                  $("#issuestatus").val(data[0].issue_status);
                                  fetchIssuesetup();
                                  $.alert({
                                      title: 'IPO Allotment',
                                      content:data[0].out_msg,
                                      type: 'green',
                                  });
                              }

                          }
                      },
                      error: function (er) {
                          alert(er)
                          console.log(er)
                      }
                  });
              }
                  catch (e) {
                      console.log(e)
                  }
               }

              } else {
                      $.alert({
                      title: 'Validation',
                      content: 'Status Need to be in Draft Mode kindly fill all the tab level details .!',
                      type: 'red'
                  });
              }
              }
          }

          function fetchIssuesetup(){
              var offer_code = $("#offer_code").val();
              var client_code = $("#clientcode").val();
              try {
              $.ajax({
                  type: "GET",
                  url: '@Url.Action("OfferFetch", "IssueSetup")',
                  dataType: 'json',
                  contentType: 'application/json; charset=utf-8',
                  data: {
                      client_code: client_code,
                      offer_code: offer_code
                  },
                  success: function (response) {
                          if (response && response.success == true ) {
                          var data = JSON.parse(response.data);
                          console.log("FETCHDATA:", data);
                          offerHeader = data.Table;
                          offerDetails = data.Table1;
                          offerBank = data.Table2;
                          offerStackHolder = data.Table3;
                          offerCategory = data.Table4;
                          offerMillstone = data.Table5;
                          if(data.Table.length > 0){
                              fetchofferHeader(data.Table[0]);
                          }
                          if(data.Table1.length > 0) {
                                      fetchofferDetails(data.Table1[0]);
                              } if(data.Table2.length > 0) {
                             fetchofferBank(data.Table2);
                              } if(data.Table3.length > 0) {
                                      fetchofferStackHolder(data.Table3);
                                  }
                          if(data.Table4.length == 0){
                             loadCatagory();
                          } else {
                             fetchofferCategory(data.Table4);
                              }   if(data.Table5.length > 0) {
                              fetchofferMillstone(data.Table5[0]);
                          }

                          if(offerDetails.length >0 && offerBank.length >0 && offerStackHolder.length >0 && offerCategory.length > 0 && offerMillstone.length > 0)  {
                              activeOfferStatus = true;
                          } else {
                              activeOfferStatus = false;
                          }
                          enableDisable();
                      } else {
                      }
                  },
                  error: function (er) {
                      alert(er)
                      console.log(er)
                  }
              });
                  var boaChecklist = '@Boachecklist';
                  var getnormalizedPath = '@normalizedPath';
                  if(boaChecklist == "Y") {
                     updateboaVisit(getnormalizedPath);
                  }
          }
              catch (e) {
                  console.log(e)
              }

          }

          function fetchofferHeader(data){
                    var role_code =  '@role_code';
                  $("#offer_header_gid").val(data.offer_header_gid);
                 if($("#createedit").val() == "VIEW") {
                    $("#createedit").val("VIEW");
                } else if($("#createedit").val() == "VIEW" && (data.ipo_status == 'MS' || data.ipo_status == 'CA' || data.ipo_status == 'MRS')){
                     $("#createedit").val("VIEW");
                } else if(data.offer_header_gid == 0){
                    $("#createedit").val("CREATE");
                } else {
                    $("#createedit").val("EDIT");
                     if(data.offer_status == 'Y') {
                      $("#headerBtnsubmit").prop('disabled', false);
                  } else {
                      $("#headerBtnsubmit").prop('disabled', true);
                  }
                }

                if(data.offer_type == "Rights Offer") {
                    $("#cutoffprices").hide();
                    $("#maxprices").hide();
                    $("#minprices").hide();
                    $("#fixedprice").hide();
                    $("#pricetypes").hide();
                    $("#lotsizes").hide();
                    $("#recordprice").show();
                    $("#ratios").show();
                    $("#empdiscount").prop('disabled', true);
                     } else {
                        $("#cutoffprices").show();
                        $("#maxprices").show();
                        $("#minprices").show();
                        $("#fixedprice").show();
                        $("#pricetypes").show();
                        $("#lotsizes").show();
                        $("#recordprice").hide();
                        $("#ratios").hide();
                    $("#empdiscount").prop('disabled', false);
                }

                  $("#offer_code").val(data.offer_code);
                  $("#offer_type").val(data.offer_type);
                  $("#listing").val(data.offer_listing_no);
                  $("#isin").val(data.offer_isin);
                  $("#status").val(data.offer_status);
                  if(data.offer_status == "Y") {
                      $("#issuestatus").val("Active");
                  } else  if(data.offer_status == "D") {
                      $("#issuestatus").val("Draft");
                  }
                  $("#empdiscount").val(data.offer_empdiscount);
                  $("#remarks").val(data.offer_remarks);
                  $("#clientcode").val(data.client_code);
                  $("#clientname").val(data.client_name);
                  $("#ipostatus").val(data.ipo_status);
              }


      // ----------------- Offer Details ------------------


          function fetchofferDetails(data){
                  $("#offer_detail_gid").val(data.offer_detail_gid);
                  $("#preissue").val(data.offer_precapital);
                  $("#issuesize").val(data.offer_issuesize);
                  $("#postissue").val(data.offer_postcapital);
                  $("#lotsize").val(data.offer_lotsize);
                  $("#facevalue").val(data.offer_facevalue);
                  $("#premium").val(data.offer_premiun);
                  $("#pricetype").val(data.offer_pricetype).trigger("change");
                  $("#fprice").val(data.offer_fixedprice);
                  $("#minprice").val(data.offer_maximumprice);
                  $("#maxprice").val(data.offer_minimumprice);
                  $("#cutoffprice").val(data.offer_cutoffprice);
                  var date = new Date(data.record_cutoff_date);
                    var year = date.getFullYear();
                    var month = String(date.getMonth() + 1).padStart(2, '0');
                    var day = String(date.getDate()).padStart(2, '0');
                    $("#recorddate").val(year + "-" + month + "-" + day);
                  $("#ratio").val(data.rights_ratio_numerator + ":" + data.rights_ratio_denominator);

              }

          function saveofferDetails(){
                 var status = $("#status").val();
                 var preissue = $("#preissue").val();
                 var vratio = $("#ratio").val();
                   var clientname = $("#clientname").val();
