@{
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
    var userName = Context.Session.GetString("user_name");
    var userRole = Context.Session.GetString("user_role");
    var userCode = Context.Session.GetString("user_code");
    var roleName = Context.Session.GetString("role_name");   
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>File Import</title>
    <style>
        .content-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link {
            background-color: #027ed1 !important;
            color: #fff !important;
        }

        .nav-tabs .nav-item .nav-link:not(.active) {
            background-color: #716969;
            color: #fff;
        }


        /* Alternate row color */
        #datasetList .k-grid-content tr.k-alt td {
            background-color: #fff;
            color: #000;
        }

        /* Consistent borders */
        #datasetList .k-grid-header th,
        #datasetList .k-grid-content td {
            border-right: 1px solid #ddd;
        }

            /* Remove last border */
            #datasetList .k-grid-header th:last-child,
            #datasetList .k-grid-content td:last-child {
                border-right: none;
            }

        /* Fixed layout for alignment */
        #datasetList .k-grid-header table,
        #datasetList .k-grid-content table {
            table-layout: fixed;
            width: 100%;
        }

        #datasetList .k-grid-content tr:last-child td {
            border-bottom: 1px solid #dcdcdc !important;
        }
        /* Prevent wrapping */
        #datasetList .k-grid-header th,
        #datasetList .k-grid-content td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Compact size */
        #datasetList .k-grid-content td {
            padding: 3px 6px;
            font-size: 12px;
            line-height: 18px;
            background: #fff;
        }

        #datasetList .k-grid-header th {
            padding: 4px 6px;
            font-size: 12px;
            line-height: 18px;
        }

        /* Compact row height */
        #datasetList .k-grid-content tr {
            height: 26px;
        }

        #datasetList .k-grid-header tr {
            height: 28px;
        }

        .k-grid td {
            padding: 2px 2px;
            font-size: 13px;
        }

        td {
            font-size: 13px;
        }
        /* Alternate row color */
        #infoGrid .k-grid-content tr.k-alt td {
            background-color: #fff;
            color: #000;
        }

        /* Consistent borders */
        #infoGrid .k-grid-header th,
        #infoGrid .k-grid-content td {
            border-right: 1px solid #ddd;
        }

            /* Remove last border */
            #infoGrid .k-grid-header th:last-child,
            #infoGrid .k-grid-content td:last-child {
                border-right: none;
            }

        /* Fixed layout for alignment */
        #infoGrid .k-grid-header table,
        #infoGrid .k-grid-content table {
            table-layout: fixed;
            width: 100%;
        }

        /* Prevent wrapping */
        #infoGrid .k-grid-header th,
        #infoGrid .k-grid-content td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Compact size */
        #infoGrid .k-grid-content td {
            padding: 3px 6px;
            font-size: 12px;
            line-height: 18px;
            background: #fff;
        }

        #infoGrid .k-grid-header th {
            padding: 4px 6px;
            font-size: 12px;
            line-height: 18px;
        }

        /* Compact row height */
        #infoGrid .k-grid-content tr {
            height: 26px;
        }

        #infoGrid .k-grid-header tr {
            height: 28px;
        }
    </style>
</head>

<body class="hold-transition skin-blue sidebar-mini fixed">
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="card-body" style="margin-top:5px;height: 556px;width: 103%;margin-left: -18px;">
                <div class="row" style="margin-top: -17px;">
                    <div class="col-sm-5">
                        <label class="form-label" for="ctype" data-field="ctype">IPO Name</label>&nbsp;<span style="font-size: 12px;color:red;font-weight: bold;">*</span>
                        <input type="text" class="form-control" id="iponame" readonly />
                        <input type="hidden" class="form-control" id="iponames" readonly />
                        <input type="text" class="form-control" id="ipocode" hidden />
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-5">
                        <label class="form-label" for="pipeline" data-field="pipeline">Pipeline</label>&nbsp;<span style="font-size: 12px;color:red;font-weight: bold;">*</span>
                        <select id="pipeline" onchange="getPipeline_code()" class="form-select"></select>
                    </div>
                    <div class="col-sm-1">
                        <img style="margin-top: 35px; margin-left: 23px;height: 25px; width: 25px; cursor:pointer;" onclick="downloadTemplate()" src="~/Assets/images/download.png" />
                    </div>
                    <div class="col-sm-5">
                        <label class="form-label" for="dataset" data-field="dataset">Dataset</label>
                        <select id="dataset" class="form-select"></select>
                    </div>
                    <div class="col-sm-1">
                        <img src="/Assets/images/topnotes.png"
                             style="cursor:pointer;width:18px;margin-top:35px;"
                             onclick="openSelectedInfoModel()"
                             data-bs-toggle="modal"
                             data-bs-target="#myModal" />
                    </div>
                </div>

                <div class="row" style="margin-top:15px;">
                    <div id="categoryrow" class="col-sm-3">
                        <label class="form-label" for="bank" data-field="bank">Select Category</label>&nbsp;<span style="font-size: 12px;color:red;font-weight: bold;">*</span>
                        <select id="category" class="form-select">
                            <option value="">-- Select Category -- </option>
                            <option value="ASBA">ASBA</option>
                            <option value="Non ASBA">Non ASBA</option>
                        </select>
                    </div>
                    <div id="rightsissuerow" class="col-sm-3" style="display:none">
                        <label class="form-label" for="bank" data-field="bank">Select Category</label>&nbsp;<span style="font-size: 12px;color:red;font-weight: bold;">*</span>
                        <select id="rightissue" class="form-select">
                            <option value="">-- Select Category -- </option>
                            <option value="NSDL">NSDL</option>
                            <option value="CDSL">CDSL</option>
                            <option value="Physical">Physical</option>
                        </select>
                    </div>
                    <div id="bankrow" class="col-sm-3" style="display: none;">
                        <label class="form-label" for="bank" data-field="bank">Select Bank</label>&nbsp;<span style="font-size: 12px;color:red;font-weight: bold;">*</span>
                        <select id="bank" class="form-select">
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label" for="pipeline" data-field="pipeline">Choose Excel</label>&nbsp;<span style="font-size: 12px;color:red;font-weight: bold;">*</span>
                        <input class="form-control" type="file" id="MultipleFile" multiple>
                    </div>
                    <div class="col-sm-3">
                        <button type="button" class="btn btn-primary" id="btnStart" onclick="startprocess()" style="padding: 3px 25px;margin-top:28px;width:40%;margin-right:10px;">Start</button>
                    </div>                   
                </div>

                <div class="row" id="rilists" style="margin-top:20px; display:none;">
                    <div class="col-sm-3">
                        <table class="table table-bordered table-sm">
                            <thead style="background-color:#365b9f; color:#fff;">
                                <tr>
                                    <td>Bendem Files</td>
                                    <td>Total</td>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>NSDL</td>
                                    <td id="nsdlTotal">0</td>
                                </tr>
                                <tr>
                                    <td>CDSL</td>
                                    <td id="cdslTotal">0</td>
                                </tr>
                                <tr>
                                    <td>Physical</td>
                                    <td id="physicalTotal">0</td>
                                </tr>
                                <tr>
                                    <td>Share Capital</td>
                                    <td id="sharecapital">0</td>
                                </tr>
                                <tr>
                                    <td>Over All Total</td>
                                    <td id="overallTotal">0</td>
                                </tr>
                                <tr>
                                    <td>Pre Offer Capital Total</td>
                                    <td id="preOfferCapitalTotal">0</td>
                                </tr>
                            </tbody>
                        </table>

                        <div id="riValidationMessage"
                             style="font-weight:bold; margin-top:10px;">
                        </div>
                    </div>
                </div>             

            </div>
        </div>
    </div>

    <div class="modal" id="myModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal body -->
                <div class="modal-body">
                    <div class="row">
                        <div class="col-sm-4">
                        </div>
                        <div class="col-sm-4">
                            <h4 style="font-size: 15px;text-align: center;">Info</h4>
                        </div>
                        <div class="col-sm-4">
                            <i class="bx bx-x cursor-pointer" data-bs-dismiss="modal" style="color: #000000;float:right"></i>
                        </div>
                    </div>
                    <hr style="margin-top:-6px;" />
                    <div class="row">
                        <div class="col-sm-12">
                            @* <div id="infoGrid"></div> *@
                            <div id="gd_jobhistory">
                                <div id="grid_jobhistory">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>


</body>

</html>
<script>
         var selectedPipeline = "";
        var selectedDataset = "";
        var iponames = "";
                 $(document).ready(function () {
            $('#navhead').text('File Import');            
           var ipoName = localStorage.getItem("selectedIPOText");
            var ipocode = localStorage.getItem("selectedIPO");
            var savedIPO = localStorage.getItem("selectedIPO");
            var offerType = localStorage.getItem("selectedOfferType");
            iponames = localStorage.getItem("selectedIPOText");
            console.log("IPO Name:", ipoName);
            console.log("IPO Code:", ipocode);
            console.log("savedIPO:", savedIPO);
            console.log("Offer Type:", offerType);
             if (offerType === "Rights Offer") {
                $("#rilists").show();
                // Get already existing totals
                getTotal();
            } else {
                $("#rilists").hide();
            }
            // Use based on element type
            $("#iponame").val(ipoName);   // or .text()

            $("#ipocode").val(ipocode);   // or .text()
              showgrid();
               grid_jobhistory([]);

               showpipelinelist();

        $("#btnPre").click(function () {

            var tabTrigger = document.querySelector('button[data-bs-target="#navs-top-list"]');
            var tab = new bootstrap.Tab(tabTrigger);
            tab.show();
            $("#datasetList").show();
        });

            if (offerType == "Rights Offer") {
                $("#rilists").show();
                } else {
                    $("#rilists").hide();
            }
    });


    function loadBank(){
         $.ajax({
             type: "POST",
            url: '@Url.Action("BankDetails", "FileImport")',
            contentType: "application/json",
            success: function (response) {
                if (response.authExpired) {
                    $.alert({
                        title: 'Unauthorized',
                        content: response.message || 'Unauthorized User',
                        type: 'red',
                        buttons: {
                            ok: {
                                text: 'OK',
                                action: function () {
                                    window.location.href = '/login/logout';
                                }
                            }
                        }
                    });
                    return;
                }
                    var result = JSON.parse(response.data);
                    $("#bank").empty();
                $("#bank").append('<option value="">--- Select Bank ---</option>');
                $.each(result.Table, function (index, item) {
                  $("#bank").append(
                        '<option value="' + item.bank_code + '">' +
                        item.bank_name +
                        '</option>'
                    );

                });
            }
        });
    }

      function showgrid() {
            $.ajax({
            type: "GET",
            url: '@Url.Action("GetDatasetList", "FileImport")',
            dataType: "json",
            success: function (response) {
                if (!response.success) {
                    console.log(response.message);
                    return;
                }
                var data = response.data;
             $("#datasetList").kendoGrid({
                        dataSource: {
                            data: data,
                            pageSize: 10
                        },
                        height: 300,
                        pageable: true,
                        sortable: true,
                        filterable: true,
                            columns: [
                                {
                                    title: "Select",
                                    width: 70,
                                       template: "<div style='display:flex; justify-content:center'>\
                                    <input type='radio' name='clientSelect' value='#=dataset_gid#' \
                                    data-code='#=dataset_code#' \
                                    data-name='#=dataset_name#'>\
                                    </div>"
                                },
                                { field: "dataset_gid", title: "Dataset ID", hidden: true },
                                { field: "dataset_code", title: "Dataset Code" ,hidden: true },
                                { field: "dataset_name", title: "Dataset Name" },
                                { field: "dataset_category", title: "Category" },
                                { field: "dataset_table_name", title: "Dataset Table Name", hidden: true },
                                { field: "system_flag", hidden: true },
                                // {
                                //     title: "Info",
                                //     width: 80,
                                //    template: '<img src="/Assets/images/topnotes.png" style="cursor:pointer;width:18px;" onclick="openInfoModel(\'#=dataset_code#\')" data-bs-toggle="modal" data-bs-target="\\#myModal" />'
                                // }
                                ]
                    });
            },
            error: function (xhr) {
                console.log("Error:", xhr.responseText);
            }
        });

        }


     function openSelectedInfoModel() {

        var dataset_code = $("#dataset").val();

        console.log(dataset_code);

        if (dataset_code) {
            openInfoModel(dataset_code);
        }
        else {
            alert("Please select dataset");
        }
    }

    function showpipelinelist() {
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPipelinetList", "FileImport")',
            dataType: "json",
            success: function (response) {
                if (!response.success) {
                    console.log(response.message);
                    return;
                }
                var data = response.data;
                $("#pipeline").empty();
                // ✅ Default option
                $("#pipeline").append(
                    $('<option>', {
                        value: '',
                        text: '-- Select --'
                    })
                );              

                // ✅ Filter only Active pipelines
                var activePipelines = data.filter(function (item) {
                    return item.pipeline_status === "Active";
                });

                 console.log("IPO Name:", iponames);
                var offerType = localStorage.getItem("selectedOfferType");
               if (offerType == "Rights Offer") {

                // Rights Issue → show ONLY Rights Offer
                var rightsOffer = activePipelines.filter(function (item) {
                   return item.pipeline_name === "benspos_nsdl" ||
               item.pipeline_name === "benspos_cdsl";
                });

                $.each(rightsOffer, function (i, item) {
                    $("#pipeline").append(
                        $('<option>', {
                            value: item.pipeline_code,
                            text: item.pipeline_name
                        })
                    );
                });


            } else {

                // Normal IPO → show all active pipelines
                $.each(activePipelines, function (i, item) {
                    $("#pipeline").append(
                        $('<option>', {
                            value: item.pipeline_code,
                            text: item.pipeline_name
                        })
                    );
                });
            }

            console.log("Active Pipelines:", activePipelines);
            },
            error: function (xhr) {
                console.log("Error:", xhr.responseText);
            }
        });
    }

      function nextprocess() {
            var selected = $("input[name='clientSelect']:checked");
            if (selected.length === 0) {
                // alert("Please select a dataset");
                 $.alert({
                    title: 'IPO Allotment' ,
                    content: "Please select a dataset",
                    type: 'red',
                });
                return;
            }
            document.getElementById("MultipleFile").value = "";
            var dataset_gid = selected.val();
            var dataset_code = selected.data("code");
            var dataset_name = selected.data("name");
            selectedDataset = selected.data("code");
            console.log("Dataset GID:", dataset_gid);
            console.log("Dataset Code:", dataset_code);
            $("#datasetname").text(dataset_name );
            if (typeof dataset_name === "string" && dataset_name.toLowerCase().includes("bank")) {
                    $("#bankrow").show();
                    $("#categoryrow").show();
                    loadBank();
                } else {
                    $("#bankrow").hide();
                }
                if ((typeof dataset_name === "string" && dataset_name.toLowerCase().includes("bendem")) ||
                (typeof dataset_name === "string" && dataset_name.toLowerCase().includes("exchange upi")) ||
                 (typeof dataset_name === "string" && dataset_name.toLowerCase().includes("exchange pan")) ||
                 (typeof dataset_name === "string" && dataset_name.toLowerCase().includes("market"))
                )
                {
                    $("#categoryrow").hide();
                }
            var tabTrigger = document.querySelector('button[data-bs-target="#navs-top-progress"]');
            var tab = new bootstrap.Tab(tabTrigger);
            tab.show();
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetPipelinetList", "FileImport")',
                data: { dataset: dataset_code },
                dataType: "json",
                success: function (response) {
                    if (!response.success) {
                        console.log(response.message);
                        return;
                    }
                   var data = response.data;
                   $("#pipeline").empty();
                    $.each(data, function (i, item) {
                        $("#pipeline").append(
                            $('<option>', {
                                value: item.pipeline_code,
                                text: item.pipeline_name
                            })
                        );
                    });
                   $("#pipeline").val(data[0].pipeline_name);
                   selectedPipeline = data[0].pipeline_code;
                   console.log(data);
                },
                error: function (xhr) {
                    console.log("Error:", xhr.responseText);
                }
            });
        }

        function startprocess() {
            var bankCode = $("#bank").val();
            var category = $("#category").val();
            console.log("Selected Bank Code:", bankCode);
            console.log("Category :", category);
            var fileInput = document.getElementById("MultipleFile");
            if (fileInput.files.length === 0) {
                alert("Please choose a file");
                return; }
            var formData = new FormData();
            formData.append("file", fileInput.files[0]);
            formData.append("pipeline_code", selectedPipeline);
            formData.append("initiated_by",'@userCode' );
            formData.append("dataset_code", selectedDataset);
            var refBankList = [
                {
                    reference_no: $("#ipocode").val(),
                    bank_code: bankCode,
                    asba_flag:category
                }
            ];
            formData.append("ref_bank_data", JSON.stringify(refBankList));
                for (let pair of formData.entries()) {
                    console.log(pair[0], pair[1]);
                }
            $.ajax({
                type: "POST",
                url: '@Url.Action("ImportData", "FileImport")',
                data: formData,
                processData: false,
                contentType: false,
                success: function (data) {
            var res = JSON.parse(data.data);
            if (res.result) {
                $.alert({
                    title: 'IPO',
                    content: "File Imported Successfully!",
                    type: 'green',
                });
                getTotal();
                $("#MultipleFile").val(null);
            }
            else {
                $.alert({
                    title: 'IPO',
                    content: res.message,
                    type: 'red',
                });
            }
        },
            error: function (err) {
                console.log(err);
                }
            });
        }

     function getTotal() {
        var ipocodes = localStorage.getItem("selectedIPO");
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetTotal", "FileImport")',
            data: { ipocodes: ipocodes },
            dataType: "json",
               success: function (response) {
                    var data = JSON.parse(response.data);
                    console.log("RI Totals:", data);
                    var totals = data.Table[0];
                    var nsdlTotal = parseFloat(totals.nsdl_total) || 0;
                    var cdslTotal = parseFloat(totals.cdsl_total) || 0;
                    var sharecapital = parseFloat(totals.share_capital) || 0;
                    var overallTotal = parseFloat(totals.total) || 0;
                    var preOfferCapitalTotal = parseFloat(totals.offer_postcapital) || 0;

                    $("#nsdlTotal").text(nsdlTotal);
                    $("#cdslTotal").text(cdslTotal);
                    $("#sharecapital").text(sharecapital);
                    $("#overallTotal").text(overallTotal);
                    $("#preOfferCapitalTotal").text(preOfferCapitalTotal);

                    // Compare totals
                    if (overallTotal === sharecapital) {
                        $("#riValidationMessage")
                            .text("Totals are tallied.. Eligible for Run Entitlement.")
                            .css("color", "green");
                    } else {
                        $("#riValidationMessage")
                            .text("Totals are not tallied.. Not eligible for Run Entitlement.")
                            .css("color", "red");
                    }

                    $("#rilists").show();
                },

            error: function (err) {
                console.log("GetTotal Error:", err);
            }
        });
    }

        function getPipeline_code() {
            selectedPipeline = $("#pipeline").val();
            console.log(selectedPipeline);
              $.ajax({
                type: "GET",
                url: '@Url.Action("GetDatasettList", "FileImport")',
                data: { Pipeline_code: selectedPipeline },
                dataType: "json",
                   success: function (response) {
                    if (!response.success) {
                        console.log(response.message);
                        return;
                    }

                    var data = response.data;
                    console.log("RI : ", data);
                    $("#dataset").empty();
                    var hasBankFile = data.some(function (item) {
                        return item.dataset_name === "Bank File";
                    });
                    if (hasBankFile) {
                        $("#bankrow").show();
                        $("#categoryrow").show();
                        loadBank();
                    }
                    else {
                        $("#bankrow").hide();
                    }

                   var hasCategory = data.some(function (item) {
                        return item.dataset_name &&
                               (
                                   item.dataset_name.includes("ASBA") ||
                                   item.dataset_name.includes("non ASBA")
                               );
                    });
                    var hasRightsissue = data.some(function (item) {
                        return item.dataset_name &&
                               (
                                   item.dataset_name.includes("tbenpos") ||
                                     item.dataset_name.includes("benposcdsl")
                               );
                    });
                  if (hasBankFile || hasCategory) {
                        $("#categoryrow").show();
                    }
                    else {
                        $("#categoryrow").hide();
                    }

                    if(hasRightsissue) {
                        $("#rightsissuerow").hide();
                        $("#categoryrow").hide();
                    } else {
                        $("#categoryrow").hide();
                        $("#rightsissuerow").hide();
                    }
                    $.each(data, function (i, item) {
                        $("#dataset").append(
                            $('<option>', {
                                value: item.dataset_code,
                                text: item.dataset_name
                            })
                        );
                    });
                    // Optional - select first item
                    if (data.length > 0) {
                        $("#dataset").val(data[0].dataset_code);
                        selectedDataset = data[0].dataset_code;
                    }
                    console.log(data);
                },
                error: function (xhr) {
                    console.log("Error:", xhr.responseText);
                }
            });
        }

             function infopopupGrid_old(e) {
        var grid = $("#infoGrid").data("kendoGrid");
        var row = $(e).closest("tr");
        var dataItem = grid.dataItem(row);
        var dscode=dataItem.dataset_code; alert(dscode); consile.log(dscode);
        window.location.href = "../IssueSetup/IssueSetup";
    }

    function openInfoModel(dataset_code) {
        try {
    customAjax({
        type: "POST",
        url: '@Url.Action("datasethistory", "FileImport")',
        dataType: 'json',
        contentType: "application/json",
        data: JSON.stringify({
            ipo_code: $("#ipocode").val().trim(),
            dataset_code: dataset_code
        }),
        success: function (response) {
            if (response.authExpired) {
                $.alert({
                    title: 'Unauthorized',
                    content: response.message || 'Unauthorized User',
                    type: 'red',
                    buttons: {
                        ok: function () {
                            window.location.href = '/login/logout';
                        }
                    }
                });
                return;
            }
            console.log("Response:", response.data);
            var grid = $("#grid_jobhistory").data("kendoGrid");
            grid.dataSource.data([]);
            if (grid && response.success) {
                    let data = response.data;
                    if (data && data.Table) {
                        data = data.Table;
                    }
                    grid.dataSource.data(data || []);
                    $("#myModal").modal("show");
                } else {
                    grid.dataSource.data([]);
                }

        },
        error: function (xhr) {
            console.log("Error:", xhr.responseText);
            alert("Something went wrong while fetching info.");
        }
    });
     } catch (e) {
        console.log(e);
    }
        }


</script>

