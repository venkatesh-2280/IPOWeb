@{
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Chat Assistant</title>
    <style>
        #chatMessages { height: 480px; overflow-y: auto; padding: 15px; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 6px; }
        .chat-msg { margin-bottom: 12px; max-width: 80%; padding: 8px 12px; border-radius: 8px; white-space: pre-wrap; }
        .chat-msg.user { background: #0d6efd; color: #fff; margin-left: auto; }
        .chat-msg.assistant { background: #fff; border: 1px solid #dee2e6; margin-right: auto; }
        .chat-msg.assistant table { border-collapse: collapse; margin-top: 6px; }
        .chat-msg.assistant table td, .chat-msg.assistant table th { border: 1px solid #ccc; padding: 4px 8px; font-size: 13px; }
    </style>
</head>
<body class="hold-transition skin-blue sidebar-mini fixed">
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center" style="margin-bottom:10px;">
                    <h5><i class="bx bx-message-dots"></i>&nbsp;Ask the IPO Assistant</h5>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetChat()">New chat</button>
                </div>
                <div id="chatMessages"></div>
                <div class="row" style="margin-top:10px;">
                    <div class="col-sm-10">
                        <input type="text" class="form-control" id="chatInput" placeholder="e.g. How many allottees for CL00037-41?" onkeydown="if(event.key==='Enter'){sendChatMessage();}" />
                    </div>
                    <div class="col-sm-2">
                        <button type="button" class="btn btn-primary w-100" id="btnSend" onclick="sendChatMessage()"><i class="bx bx-send"></i>&nbsp;Send</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
<script>
    $(document).ready(function () {
        $('#navhead').text('Chat Assistant');
        appendMessage('assistant', 'Hi, ask me about any IPO offer - allotment counts, subscription rates, rejections, or bank/UPI bid summaries.');
    });

    function appendMessage(role, text) {
        var $div = $('<div>').addClass('chat-msg').addClass(role).text(text);
        $('#chatMessages').append($div);
        $('#chatMessages').scrollTop($('#chatMessages')[0].scrollHeight);
    }

    function sendChatMessage() {
        var text = $('#chatInput').val().trim();
        if (!text) return;

        appendMessage('user', text);
        $('#chatInput').val('');
        $('#btnSend').prop('disabled', true);

        customAjax({
            type: "POST",
            url: '@Url.Action("Ask", "Chat")',
            data: JSON.stringify({ Message: text }),
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                $('#btnSend').prop('disabled', false);
                if (response && response.success) {
                    appendMessage('assistant', response.reply);
                } else {
                    appendMessage('assistant', (response && response.message) || 'Sorry, something went wrong.');
                }
            },
            error: function () {
                $('#btnSend').prop('disabled', false);
                appendMessage('assistant', 'Sorry, something went wrong.');
            }
        });
    }

    function resetChat() {
        customAjax({
            type: "POST",
            url: '@Url.Action("ResetChat", "Chat")',
            success: function () {
                $('#chatMessages').empty();
                appendMessage('assistant', 'Started a new chat. Ask me anything about an IPO offer.');
            }
        });
    }
</script>
